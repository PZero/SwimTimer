node_modules/
dist/
.firebase/
.pio/
build/
*.bin
*.elf
*.log
*.stackdump

# Sistema
.DS_Store
Thumbs.db
desktop.ini
*.tmp
~$*

# Impostazioni locali di Claude Code
.claude/settings.local.json

# Scritto dalla CI al momento della compilazione
firmware/test-collegamenti/versione.h

# Registrazioni in vasca della XIAO (dati di salute): mai nel repository
*.swr
firmware/xiao-stream/registrazioni/
firmware/xiao-stream/*.csv

# Video: non nel repository (pubblicato su YouTube, link nel README)
media/video/*.mp4
media/video/*.wav
media/video/*.mov
media/video/fotogrammi/
media/video/tmp/

# eccezione: firmware XIAO pubblicato per l aggiornamento via Bluetooth
!firmware/xiao-stream/release/xiao.bin

# Prova in piscina: progetti di annotazione, eventi esportati, video (dati di salute / personali)
*.swimproj.json
eventi*.csv
*.mp4
*.mov

# Generato a ogni deploy (firebase/scrivi-versione.mjs)
app/versione.json

# Copiati dal predeploy (firebase/prepara-strumenti.mjs): non versionare
app/strumenti/
app/display/

# Video v3: miniature con fotogrammi reali dell autore (dati personali), generate in locale
media/video/miniatura_test1_*.png

__pycache__/

# Password del Wi-Fi della stazione (display-sync)
firmware/display-sync/segreti.h
